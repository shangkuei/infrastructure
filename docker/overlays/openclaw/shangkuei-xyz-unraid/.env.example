# OpenClaw Docker Compose Environment for shangkuei-xyz-unraid
# Copy to .enc.env and fill in actual values, then encrypt with: make encrypt
#
# NOTE: OpenClaw application secrets are in config/.env (separate from this file)
#       This file is for Docker Compose variables only

# =============================================================================
# Docker Image Configuration
# =============================================================================
# Use local build or specify a registry image
OPENCLAW_IMAGE=openclaw:local

# =============================================================================
# Tailscale Configuration (for docker-compose.tailscale.override.yml)
# =============================================================================
# Auth key from: https://login.tailscale.com/admin/settings/keys
# Use reusable key or OAuth client for production
TS_AUTHKEY=tskey-auth-xxxxx

# Extra arguments for tailscale up (optional)
# Example: --advertise-tags=tag:server --hostname=openclaw
TS_EXTRA_ARGS=

# Domain for Tailscale HTTPS certificate (from tailnet)
# Example: openclaw.your-tailnet.ts.net
TS_CERT_DOMAIN=openclaw.your-tailnet.ts.net

# =============================================================================
# General Settings
# =============================================================================
# Timezone
TZ=Asia/Taipei
